# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
MONGO_DB_NAME=scholar_db

# Scraper (local Tor-based — not actively used)
TOR_PATH=D:\tor\tor\tor.exe
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051

# API Security
API_SECRET_KEY=change-this-in-production
SCRAPER_SCRIPT_PATH=scraper/scraper.py

# Webhook (shared secret between the GitHub Actions scraper and this API)
# Must match the WEBHOOK_SECRET GitHub Actions secret set in the scraper repo
WEBHOOK_SECRET=change-this-in-production

# How many hours before an author is considered stale and needs re-scraping.
# Default 44h matches a once-per-2-days scrape schedule with a 4h grace window.
SCRAPE_STALENESS_HOURS=44
